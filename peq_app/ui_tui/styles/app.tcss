/*
 * PEQ Textual TUI — Minimalist Dark Theme
 *
 * Design: someone tweaking EQ at their desk in a dim room,
 * focused on sound. Flat, clean, editorial.
 *
 * Principles:
 *   - 1px borders only, warm off-black canvas
 *   - Single muted accent per theme
 *   - No side-stripe borders, no gradient text
 *   - Typographic hierarchy via weight + scale
 *
 * Amber (default) — desaturated warm gold accent on off-black.
 * Slate / Mono themes applied at runtime via Python (press 't').
 */

/* ── Base ─────────────────────────────────────────────── */

Screen {
    layout: grid;
    grid-rows: auto 1fr 1;
    grid-columns: 1fr;
    background: #0d0d0f;
    color: #d4d4d8;
}

/* ── App layout ─────────────────────────────────────── */

#app-container {
    layout: horizontal;
    height: 1fr;
}

#channel-panel {
    width: 28;
    height: 1fr;
    background: #0d0d0f;
    border-right: solid #2a2a2e;
}

#eq-area {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#eq-panel {
    height: 1fr;
    min-height: 1;
    background: #0d0d0f;
    overflow: hidden;
}

/* ── Preset bar — buttons fill full width, match EQ band width ── */

#preset-bar {
    width: 1fr;
    height: auto;
    min-height: 5;
    background: #121215;
    border-top: solid #2a2a2e;
    padding: 1 1;
    layout: horizontal;
    overflow: hidden;
}

#preset-bar Button {
    width: 1fr;
    min-width: 10;
    height: auto;
    margin: 0 1;
    background: #1f1f23;
    color: #d4d4d8;
    border: solid #2a2a2e;
    text-overflow: ellipsis;
}

#preset-bar Button:hover {
    background: #2a2a2e;
    color: #d4d4d8;
}

/* ── Status footer ──────────────────────────────────── */

#status-footer {
    height: 1;
    background: #121215;
    border-top: solid #2a2a2e;
    color: #909099;
    padding: 0 1;
    layout: horizontal;
}

#status-footer .status-left {
    width: 1fr;
    content-align: left middle;
}

#status-footer .status-right {
    width: auto;
    content-align: right middle;
}

/* ── Channel panel header ───────────────────────────── */

#channel-header {
    height: 3;
    background: #121215;
    border-bottom: solid #2a2a2e;
    padding: 0 2;
    text-style: bold;
    color: #d4d4d8;
    content-align: left middle;
}

/* ── Channel rows — background tint, no side-stripe ──── */

ChannelRow {
    height: 3;
    padding: 0 2;
    border-bottom: solid #1f1f23;
}

ChannelRow:hover {
    background: #1a1a1e;
}

ChannelRow.-selected {
    background: #1f1d18;
}

ChannelRow .channel-name {
    color: #d4d4d8;
    text-style: bold;
}

ChannelRow .channel-mute-btn {
    width: 3;
    min-width: 3;
    margin: 0 1 0 0;
    background: #1f1f23;
    color: #84848e;
    border: none;
    padding: 0;
    overflow: hidden;
    text-style: none;
    content-align: center middle;
}

ChannelRow .channel-mute-btn:hover {
    background: #2a2a2e;
}

ChannelRow .channel-mute-btn.-muted {
    background: #2a1f1f;
    color: #a05050;
}

ChannelRow .channel-volume-text {
    color: #909099;
    text-style: none;
    width: 6;
    content-align: right middle;
}

ChannelRow .channel-app-binary {
    color: #84848e;
    text-style: italic;
}

/* ── EQ Panel header ────────────────────────────────── */

#eq-header {
    height: 3;
    padding: 0 2;
    text-style: bold;
    color: #d4d4d8;
    content-align: left middle;
}

#eq-header .channel-subtitle {
    color: #909099;
    text-style: none;
}

/* ── EQ bands container ─────────────────────────────── */

#eq-bands-container {
    width: 1fr;
    height: 1fr;
    layout: horizontal;
    padding: 0 1;
}

#freq-labels {
    width: 1fr;
    height: 1;
    layout: horizontal;
    padding: 0 1;
    color: #909099;
}

.freq-label {
    width: 1fr;
    content-align: center middle;
    text-style: none;
}

/* ── EQ Band Widget — track fills 1fr container ─────── */

EQBandWidget {
    width: 1fr;
    min-width: 7;
    height: 100%;
    layout: vertical;
    align: center bottom;
    padding: 0 1;
}

EQBandWidget .band-track {
    width: 100%;
    background: #1f1f23;
    height: 1fr;
}

EQBandWidget .band-fill {
    width: 100%;
    background: #3a3a3e;
}

EQBandWidget .band-fill.-active {
    background: #84848e;
}

EQBandWidget .band-fill.-highlighted {
    background: #d4d4d8;
}

EQBandWidget .band-gain-label {
    height: 1;
    color: #909099;
    content-align: center middle;
    text-style: none;
}

EQBandWidget .band-freq-label {
    height: 1;
    color: #909099;
    content-align: center middle;
    text-style: none;
}

/* ── Volume slider row ──────────────────────────────── */

#volume-row {
    height: 1;
    padding: 0 2;
    layout: horizontal;
    margin-bottom: 1;
}

#volume-row .volume-label {
    width: 8;
    content-align: left middle;
    color: #909099;
}

VolumeSlider {
    width: 1fr;
    height: 1;
    content-align: left middle;
    background: #1f1f23;
}

VolumeSlider .slider-fill {
    height: 100%;
    background: #84848e;
}

/* ── Empty state ────────────────────────────────────── */

#empty-eq {
    height: 100%;
    content-align: center middle;
    color: #84848e;
}
